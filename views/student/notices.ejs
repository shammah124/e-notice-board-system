<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>School Notices</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container">

        <a class="navbar-brand" href="#">
            E-Notice Board
        </a>

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">

            <ul class="navbar-nav ms-auto">

                <li class="nav-item">
                    <a class="nav-link" href="/adverts/public/home">
                        Home
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/notices/public/all">
                        Notices
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/results/public/all">
                        Results
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/timetables/public/all">
                        Timetables
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/admissions/public/all">
                        Admissions
                    </a>
                </li>

            </ul>

        </div>

    </div>

</nav>

<div class="container mt-5">

    <div class="text-center mb-5">

        <h1>School Notices</h1>

        <p>Latest Academic Announcements</p>

    </div>
    <form
    action="/notices/search"
    method="GET"
    class="mb-5"
>

    <div class="input-group">

        <input
            type="text"
            name="keyword"
            class="form-control"
            placeholder="Search notices..."
        >

        <button class="btn btn-primary">
            Search
        </button>

    </div>

</form>

    <% notices.forEach(notice => { %>

        <div class="card shadow mb-4">

            <div class="card-body">

                <h3><%= notice.title %></h3>

                <hr>

                <p><%= notice.content %></p>

                <small>
                    Posted By:
                    <%= notice.fullname %>
                </small>

            </div>

        </div>

    <% }) %>

</div>

</body>
</html>