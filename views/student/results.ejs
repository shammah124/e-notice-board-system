<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Results</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container">

        <a class="navbar-brand" href="#">
            E-Notice Board
        </a>

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">

            <ul class="navbar-nav ms-auto">

                <li class="nav-item">
                    <a class="nav-link" href="/adverts/public/home">
                        Home
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/notices/public/all">
                        Notices
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/results/public/all">
                        Results
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/timetables/public/all">
                        Timetables
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/admissions/public/all">
                        Admissions
                    </a>
                </li>

            </ul>

        </div>

    </div>

</nav>

<div class="container mt-5">

    <div class="text-center mb-5">

        <h1>Published Results</h1>

        <p>View and Download Academic Results</p>

    </div>

    <div class="card shadow p-4">

        <table class="table table-bordered">

            <thead>

                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Date Uploaded</th>
                    <th>PDF</th>
                </tr>

            </thead>

            <tbody>

                <% results.forEach(result => { %>

                    <tr>

                        <td><%= result.id %></td>

                        <td><%= result.title %></td>

                        <td>
                            <%= result.created_at.toDateString() %>
                        </td>

                        <td>

                            <a
                                href="/uploads/results/<%= result.file_name %>"
                                target="_blank"
                                class="btn btn-success btn-sm"
                            >
                                View Result
                            </a>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>

</body>
</html>