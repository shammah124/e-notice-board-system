<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Notice Board System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container">

        <a class="navbar-brand" href="#">
            E-Notice Board
        </a>

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">

            <ul class="navbar-nav ms-auto">

                <li class="nav-item">
                    <a class="nav-link" href="/adverts/public/home">
                        Home
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/notices/public/all">
                        Notices
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/results/public/all">
                        Results
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/timetables/public/all">
                        Timetables
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/admissions/public/all">
                        Admissions
                    </a>
                </li>

            </ul>

        </div>

    </div>

</nav>

<div class="bg-primary text-white p-5 text-center">

    <h1>Welcome to the E-Notice Board System</h1>

    <p>
        Access Academic Information Online Anytime
    </p>

</div>

<div class="container mt-5">

    <h2 class="mb-4">Latest Advertisements</h2>

    <div class="row">

        <% adverts.forEach(advert => { %>

            <div class="col-md-4 mb-4">

                <div class="card shadow">

                    <img
    src="/uploads/adverts/<%= advert.image_name %>"
    class="card-img-top img-fluid"
    style="height: 300px; object-fit: contain; background: #f8f9fa; cursor: pointer;"
    data-bs-toggle="modal"
    data-bs-target="#advertModal<%= advert.id %>"
>

                    <div class="card-body">

                        <h5><%= advert.title %></h5>

                    </div>
                    <div
    class="modal fade"
    id="advertModal<%= advert.id %>"
    tabindex="-1"
>

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    <%= advert.title %>
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>

            </div>

            <div class="modal-body text-center">

                <img
                    src="/uploads/adverts/<%= advert.image_name %>"
                    class="img-fluid"
                >

            </div>

        </div>

    </div>

</div>

                </div>

            </div>

        <% }) %>

    </div>

</div>

<div class="container mt-5 mb-5">

    <h2 class="mb-4">Latest Notices</h2>

    <% notices.forEach(notice => { %>

        <div class="card shadow mb-4">

            <div class="card-body">

                <h4><%= notice.title %></h4>

                <hr>

                <p><%= notice.content %></p>

                <small>
                    Posted By:
                    <%= notice.fullname %>
                </small>

            </div>

        </div>

    <% }) %>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<footer class="bg-dark text-white text-center p-4">

    <p>
        © 2026 E-Notice Board System.
        All Rights Reserved.
    </p>

</footer>
</body>
</html>