<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Advertisements</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

<div class="container mt-5">

    <div class="d-flex justify-content-between mb-4">

        <h2>Manage Advertisements</h2>

        <a href="/admin/dashboard" class="btn btn-dark">
            Dashboard
        </a>

    </div>

    <div class="card shadow p-4 mb-5">

        <h4>Upload Advertisement</h4>

        <form
            action="/adverts/upload"
            method="POST"
            enctype="multipart/form-data"
        >

            <div class="mb-3">

                <label>Advertisement Title</label>

                <input
                    type="text"
                    name="title"
                    class="form-control"
                    required
                >

            </div>

            <div class="mb-3">

                <label>Select Image</label>

                <input
                    type="file"
                    name="advert_image"
                    class="form-control"
                    accept=".jpg,.jpeg,.png"
                    required
                >

            </div>

            <button class="btn btn-secondary">
                Upload Advertisement
            </button>

        </form>

    </div>

    <div class="row">

        <% adverts.forEach(advert => { %>

            <div class="col-md-4 mb-4">

                <div class="card shadow">

                    <img
                        src="/uploads/adverts/<%= advert.image_name %>"
                        class="card-img-top"
                        style="height: 250px; object-fit: cover;"
                    >

                    <div class="card-body">

                        <h5><%= advert.title %></h5>

                        <a
                            href="/adverts/delete/<%= advert.id %>"
                            class="btn btn-danger btn-sm"
                        >
                            Delete
                        </a>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

</div>

</body>
</html>