<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark">

    <div class="container-fluid">

        <span class="navbar-brand">
            E-Notice Board Admin Dashboard
        </span>

        <a href="/admin/logout" class="btn btn-danger">
            Logout
        </a>

    </div>

</nav>

<div class="container mt-5">

    <% if (success.length > 0) { %>

        <div class="alert alert-success">
            <%= success %>
        </div>

    <% } %>

    <div class="card shadow p-4 mb-5">

        <h2>
            Welcome,
            <%= admin.fullname %>
        </h2>

        <p class="text-muted">
            Manage academic information efficiently
        </p>

    </div>

    <div class="row">

        <div class="col-md-4 mb-4">

            <a
                href="/notices"
                class="btn btn-primary w-100 p-4"
            >
                Manage Notices
            </a>

        </div>

        <div class="col-md-4 mb-4">

            <a
                href="/results"
                class="btn btn-success w-100 p-4"
            >
                Upload Results
            </a>

        </div>

        <div class="col-md-4 mb-4">

            <a
                href="/timetables"
                class="btn btn-warning w-100 p-4"
            >
                Upload Timetables
            </a>

        </div>

        <div class="col-md-4 mb-4">

            <a
                href="/admissions"
                class="btn btn-info w-100 p-4"
            >
                Admission Lists
            </a>

        </div>

        <div class="col-md-4 mb-4">

            <a
                href="/adverts"
                class="btn btn-secondary w-100 p-4"
            >
                Advertisements
            </a>

        </div>

    </div>

</div>

</body>
</html>