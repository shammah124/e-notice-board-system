<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Notices</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

<div class="container mt-5">

    <div class="d-flex justify-content-between mb-4">

        <h2>Manage Notices</h2>

        <a href="/admin/dashboard" class="btn btn-dark">
            Dashboard
        </a>

    </div>

    <div class="card p-4 shadow mb-5">

        <h4>Create Notice</h4>

        <form action="/notices/create" method="POST">

            <div class="mb-3">

                <label>Title</label>

                <input
                    type="text"
                    name="title"
                    class="form-control"
                    required
                >

            </div>

            <div class="mb-3">

                <label>Content</label>

                <textarea
                    name="content"
                    class="form-control"
                    rows="5"
                    required
                ></textarea>

            </div>

            <button class="btn btn-primary">
                Publish Notice
            </button>

        </form>

    </div>

    <div class="card p-4 shadow">

        <h4>All Notices</h4>

        <table class="table table-bordered mt-3">

            <thead>

                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Posted By</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>

            </thead>

            <tbody>

                <% notices.forEach(notice => { %>

                    <tr>

                        <td><%= notice.id %></td>

                        <td><%= notice.title %></td>

                        <td><%= notice.fullname %></td>

                        <td>
                            <%= notice.created_at.toDateString() %>
                        </td>

                        <td>

                            <a
                                href="/notices/edit/<%= notice.id %>"
                                class="btn btn-warning btn-sm"
                            >
                                Edit
                            </a>

                            <a
                                href="/notices/delete/<%= notice.id %>"
                                class="btn btn-danger btn-sm"
                            >
                                Delete
                            </a>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>

</body>
</html>